---
// Call + Zalo actions. "bar" is the fixed bottom bar on phones; "inline" sits in page content.
import { hotline } from '../data/contact';
interface Props { variant?: 'bar' | 'inline' }
const { variant = 'inline' } = Astro.props;
---
<div class:list={['contact-actions', `contact-actions--${variant}`]} role={variant === 'bar' ? 'region' : undefined} aria-label={variant === 'bar' ? 'Liên hệ nhanh' : undefined}>
  <a class="contact-action contact-action--call" href={hotline.tel}>
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
    <span>{variant === 'bar' ? 'Gọi ngay' : `Gọi ${hotline.display}`}</span>
  </a>
  <a class="contact-action contact-action--zalo" href={hotline.zalo} target="_blank" rel="noopener">
    <span class="zalo-mark" aria-hidden="true">Zalo</span>
    <span>{variant === 'bar' ? 'Nhắn Zalo' : 'Tư vấn qua Zalo'}</span>
  </a>
</div>
