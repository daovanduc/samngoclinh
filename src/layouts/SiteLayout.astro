---
interface Props { title?: string; description?: string }
const { title = 'Thảo Nguyên – Sâm Ngọc Linh', description = 'Sâm Ngọc Linh và dược liệu quý từ núi rừng Việt Nam.' } = Astro.props;
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#205b39" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Thảo Nguyên – về trang chủ">
          <img src="/assets/images/logo.png" alt="Thảo Nguyên – Sâm Ngọc Linh" />
        </a>
        <button class="menu-toggle" type="button" aria-label="Mở menu" aria-expanded="false" aria-controls="primary-navigation">
          <span></span><span></span><span></span>
        </button>
        <nav id="primary-navigation" class="primary-navigation" aria-label="Điều hướng chính">
          <a href="/#about">Giới thiệu</a>
          <a href="/products/">Sản phẩm</a>
          <a href="/#certificates">Nhật ký Ngọc Linh</a>
          <a href="/#contact">Liên hệ</a>
        </nav>
      </div>
    </header>
    <slot />
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('#primary-navigation');
      const setExpanded = (expanded: boolean) => {
        toggle?.setAttribute('aria-expanded', String(expanded));
        toggle?.setAttribute('aria-label', expanded ? 'Đóng menu' : 'Mở menu');
        navigation?.classList.toggle('is-open', expanded);
      };
      toggle?.addEventListener('click', () => setExpanded(toggle.getAttribute('aria-expanded') !== 'true'));
      navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setExpanded(false)));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
          setExpanded(false);
          toggle.focus();
        }
      });
    </script>
  </body>
</html>
<style is:global>
  :root { font-family: 'Montserrat', Arial, sans-serif; color: #fff; background: #123d28; font-synthesis: none; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; min-width: 320px; background: #123d28 url('/assets/images/hero-background1.jpg') center top / cover fixed; }
  a { color: inherit; }
  img { max-width: 100%; }
  .site-header { position: relative; z-index: 10; background: #205b39; }
  .header-inner { width: min(1200px, calc(100% - 48px)); min-height: 94px; margin: auto; display: flex; align-items: center; justify-content: space-between; gap: 36px; }
  .brand { display: block; flex: 0 0 270px; line-height: 0; }
  .brand img { width: 100%; height: 64px; object-fit: contain; object-position: left center; }
  .primary-navigation { display: flex; align-items: center; gap: clamp(20px, 4vw, 60px); }
  .primary-navigation a { text-decoration: none; text-transform: uppercase; font-weight: 700; font-size: clamp(.85rem, 1.4vw, 1.1rem); white-space: nowrap; }
  .primary-navigation a:hover, .primary-navigation a:focus-visible { color: #e6c85a; }
  .menu-toggle { display: none; width: 48px; height: 48px; border: 1px solid #e6c85a; background: transparent; border-radius: 8px; color: white; cursor: pointer; }
  .menu-toggle span { display: block; width: 22px; height: 2px; margin: 5px auto; background: currentColor; }
  :focus-visible { outline: 3px solid #f0d467; outline-offset: 3px; }
  .page-shell { width: min(1440px, calc(100% - 48px)); margin: 42px auto; }
  .hero { min-height: clamp(230px, 31vw, 360px); display: grid; align-items: center; padding: clamp(24px, 6vw, 84px); background: linear-gradient(90deg, rgba(14, 50, 30, .22), rgba(14, 50, 30, .1)), url('/assets/images/hero-background.jpg') center 45% / cover; }
  .hero h1 { max-width: 550px; margin: 0; color: #f7e8a5; font: italic 600 clamp(2.4rem, 6.4vw, 5rem)/1.04 Georgia, serif; }
  .hero p { max-width: 520px; font-size: clamp(1rem, 2vw, 1.3rem); line-height: 1.6; }
  .content-section { margin-top: 40px; padding: clamp(24px, 4vw, 50px); border-radius: 28px; background: rgba(20, 90, 55, .82); }
  .section-title { margin: 0 0 24px; text-align: center; color: white; font-size: clamp(1.4rem, 3vw, 2.2rem); text-transform: uppercase; }
  .category-grid, .product-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; width: min(100%, 960px); margin: auto; }
  .category-card, .product-card { min-width: 0; overflow: hidden; border-radius: 20px; background: #fff; color: #204c36; text-align: center; }
  .category-card { padding: 16px; }
  .category-card img { width: 100%; height: 145px; object-fit: contain; }
  .category-card h3 { margin: 12px 0; font-size: clamp(1rem, 1.8vw, 1.25rem); text-transform: uppercase; }
  .pill-link, .contact-button { display: inline-flex; justify-content: center; align-items: center; min-height: 44px; padding: 8px 34px; border: 0; border-radius: 999px; background: #076246; color: #fff; text-decoration: none; font-size: 1rem; }
  .product-card { padding: 16px; }
  .product-card-link { display: block; color: inherit; text-decoration: none; }
  .product-card-link:hover h2, .product-card-link:hover h3 { color: #076246; text-decoration: underline; }
  .product-card h2 { min-height: 3em; margin: 8px 0 4px; font-size: clamp(1rem, 1.6vw, 1.2rem); }
  .product-card img { width: 100%; height: clamp(150px, 18vw, 220px); object-fit: contain; }
  .product-card h3 { min-height: 3em; margin: 8px 0 4px; font-size: clamp(1rem, 1.6vw, 1.2rem); }
  .product-card p { margin: 4px 0 12px; }
  .certificate-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; padding: 14px; border-radius: 16px; background: #fff; }
  .certificate-placeholder { display: grid; min-height: 150px; place-items: center; padding: 16px; background: #14583a; color: #f4df80; text-align: center; font-weight: 600; }
  .contact-panel { display: grid; grid-template-columns: 1.4fr 1fr; align-items: center; gap: 32px; }
  .contact-panel h2 { font-size: clamp(1.3rem, 2.7vw, 2rem); text-transform: uppercase; }
  .contact-panel p { font-size: clamp(1rem, 2vw, 1.25rem); line-height: 1.8; }
  .contact-logo { width: min(100%, 260px); justify-self: center; }
  footer { padding: 22px; text-align: center; background: #103b29; }
  .catalog-page { margin-top: 30px; }
  .breadcrumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 9px; margin: 0 12px 22px; font-size: .95rem; }
  .breadcrumbs a { text-decoration: none; }
  .breadcrumbs a:hover { color: #f0d467; }
  .category-navigation { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 22px; padding: 14px 12px 22px; }
  .category-navigation a { text-decoration: none; text-transform: uppercase; font-weight: 700; }
  .category-navigation a:hover, .category-navigation a.active { color: #f0d467; }
  .category-description { max-width: 760px; margin: 0 auto 26px; line-height: 1.7; }
  .product-detail-hero { display: grid; grid-template-columns: minmax(260px, .8fr) minmax(0, 1.2fr); align-items: center; gap: clamp(28px, 6vw, 72px); padding: clamp(12px, 2vw, 24px); }
  .product-detail-hero > img { width: 100%; max-height: 460px; object-fit: contain; background: #fff; }
  .product-category { margin: 0; font-size: clamp(1.2rem, 2.5vw, 1.8rem); }
  .product-detail h1 { margin: 8px 0; font-size: clamp(1.7rem, 4vw, 2.7rem); }
  .product-size { margin: 8px 0 24px; font-size: clamp(1.2rem, 2.5vw, 1.8rem); }
  .product-description, .product-detail-copy { line-height: 1.7; }
  .product-detail-copy { margin: 28px 0 0; padding-top: 20px; border-top: 1px solid #ffffff77; }
  .product-detail-copy h2 { margin-top: 0; }
  @media (max-width: 992px) {
    .header-inner { min-height: 78px; }
    .brand { flex-basis: 230px; }
    .category-grid, .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .certificate-grid { grid-template-columns: repeat(2, 1fr); }
    .menu-toggle { display: block; }
    .primary-navigation { position: absolute; inset: 100% 0 auto; display: none; padding: 12px 24px 24px; flex-direction: column; align-items: stretch; gap: 0; background: #205b39; box-shadow: 0 12px 18px #09291866; }
    .primary-navigation.is-open { display: flex; }
    .primary-navigation a { padding: 14px 8px; border-top: 1px solid #ffffff2b; }
  }
  @media (max-width: 767px) {
    .header-inner, .page-shell { width: min(100% - 28px, 620px); }
    .brand { flex-basis: 205px; }
    .brand img { height: 58px; }
    .page-shell { margin: 20px auto; }
    .hero { min-height: 230px; background-position: 56% center; }
    .content-section { margin-top: 20px; padding: 22px 16px; border-radius: 22px; }
    .category-grid, .product-grid { grid-template-columns: minmax(0, 1fr); gap: 16px; max-width: 400px; }
    .category-card img { height: 160px; }
    .product-card img { height: 210px; }
    .certificate-placeholder { min-height: 120px; }
    .contact-panel { grid-template-columns: 1fr; }
    .category-navigation { flex-direction: column; align-items: flex-start; }
    .product-detail-hero { grid-template-columns: 1fr; }
    .product-detail-hero > img { max-height: 320px; }
  }
</style>
