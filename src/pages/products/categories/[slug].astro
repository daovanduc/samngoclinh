---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { categories, productsForCategory } from '../../../data/catalog';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const categoryProducts = productsForCategory(category.slug);
---
<SiteLayout title={`${category.title} | Thảo Nguyên`} description={category.description || `Sản phẩm thuộc danh mục ${category.title}.`}>
  <main class="page-shell catalog-page">
    <nav class="breadcrumbs" aria-label="Đường dẫn">
      <a href="/">Trang chủ</a><span aria-hidden="true">›</span><a href="/products/">Sản phẩm</a><span aria-hidden="true">›</span><span>{category.title}</span>
    </nav>
    <header class="page-heading">
      <p class="eyebrow">Danh mục sản phẩm</p>
      <h1 class="section-title centered" id="category-title">{category.title}</h1>
      {category.description && <p class="page-intro category-description">{category.description}</p>}
    </header>
    <nav class="category-navigation" aria-label="Danh mục sản phẩm">
      <a href="/products/">Tất cả sản phẩm</a>
      {categories.map((item) => <a class:list={{ active: item.slug === category.slug }} aria-current={item.slug === category.slug ? 'page' : undefined} href={`/products/categories/${item.slug}/`}>{item.title}</a>)}
    </nav>
    <section aria-labelledby="category-title">
      {categoryProducts.length > 0
        ? <div class="product-grid">{categoryProducts.map((product) => <ProductCard product={product} meta={category.title} />)}</div>
        : <p class="empty-state">Sản phẩm của danh mục này sẽ được cập nhật trong thời gian tới.</p>}
    </section>
  </main>
</SiteLayout>
