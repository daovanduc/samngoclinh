---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { categories, products } from '../../data/catalog';
const categoryTitle = (slug: string) => categories.find((category) => category.slug === slug)?.title;
---
<SiteLayout title="Tất cả sản phẩm | Thảo Nguyên" description="Danh mục sản phẩm Thảo Nguyên – Sâm Ngọc Linh.">
  <main class="page-shell catalog-page">
    <nav class="breadcrumbs" aria-label="Đường dẫn">
      <a href="/">Trang chủ</a><span aria-hidden="true">›</span><span>Sản phẩm</span>
    </nav>
    <header class="page-heading">
      <p class="eyebrow">Thảo Nguyên - Sâm Ngọc Linh</p>
      <h1 class="section-title centered" id="all-products-title">Tất cả sản phẩm</h1>
    </header>
    <nav class="category-navigation" aria-label="Danh mục sản phẩm">
      {categories.map((category) => <a href={`/products/categories/${category.slug}/`}>{category.title}</a>)}
    </nav>
    <section aria-labelledby="all-products-title">
      <div class="product-grid">
        {products.map((product) => <ProductCard product={product} meta={categoryTitle(product.category)} />)}
      </div>
    </section>
  </main>
</SiteLayout>
