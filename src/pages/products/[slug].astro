---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { categories, products, productsForCategory } from '../../data/catalog';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const category = categories.find((item) => item.slug === product.category)!;
const relatedProducts = productsForCategory(product.category)
  .filter((item) => item.slug !== product.slug)
  .slice(0, 3);
---
<SiteLayout title={`${product.title} | Thảo Nguyên`} description={product.description || `${product.title} – ${product.summary}`}>
  <main class="page-shell catalog-page">
    <nav class="breadcrumbs" aria-label="Đường dẫn">
      <a href="/">Trang chủ</a><span aria-hidden="true">›</span><a href="/products/">Sản phẩm</a><span aria-hidden="true">›</span><a href={`/products/categories/${category.slug}/`}>{category.title}</a><span aria-hidden="true">›</span><span>{product.title}</span>
    </nav>
    <article class="product-detail">
      <div class="product-detail-hero">
        <img src={product.image} alt={product.alt} />
        <div>
          <p class="product-category">{category.title}</p>
          <h1>{product.title}</h1>
          <p class="product-size">{product.summary}</p>
          {product.description && <p class="product-lead">{product.description}</p>}
          <a class="product-story-btn contact-button" href="tel:+84961851818">Liên hệ tư vấn</a>
        </div>
      </div>
      {product.product_info && <section class="product-detail-copy"><h2>Thông tin sản phẩm</h2><div class="product-detail-text">{product.product_info}</div></section>}
      {product.benefits?.length > 0 && <section class="product-detail-copy"><h2>Công dụng</h2><ul>{product.benefits.map((benefit: string) => <li>{benefit}</li>)}</ul></section>}
      {product.recommended_users && <section class="product-detail-copy"><h2>Đối tượng sử dụng</h2><div class="product-detail-text">{product.recommended_users}</div></section>}
      {product.directions && <section class="product-detail-copy"><h2>Hướng dẫn sử dụng</h2><div class="product-detail-text">{product.directions}</div></section>}
      {product.usage_notes && <section class="product-detail-copy"><h2>Lưu ý khi sử dụng</h2><div class="product-detail-text">{product.usage_notes}</div></section>}
    </article>
    {relatedProducts.length > 0 && <section class="related-products" aria-labelledby="related-products-title">
      <h2 class="section-title centered" id="related-products-title">Sản phẩm cùng danh mục</h2>
      <div class="product-grid">
        {relatedProducts.map((relatedProduct) => <ProductCard product={relatedProduct} meta={category.title} level="h3" action="Xem sản phẩm" />)}
      </div>
    </section>}
  </main>
</SiteLayout>
