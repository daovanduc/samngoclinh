---
// Homepage. Each CMS section renders with the markup and classes of the
// original branded homepage (index.html) so product-storytelling.css applies.
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { categories, certificates, products } from '../data/catalog';
import page from '../data/pages/products.json';
import { hotline } from '../data/contact';

type Item = { icon?: string; title: string; body?: string };
type Section = { type: string; title: string; body?: string; image?: string; items?: Item[]; cta_label?: string; cta_link?: string };

const known = new Set(['hero', 'categories', 'products', 'recipes', 'values', 'certificates', 'contact']);
const sections = (page.sections as Section[]).filter((section) => known.has(section.type));
const hasContact = sections.some((section) => section.type === 'contact');
const hero = sections.find((section) => section.type === 'hero');
const categoryTitle = (slug: string) => categories.find((category) => category.slug === slug)?.title;
const delay = (index: number) => String(50 + (index % 3) * 50);
---
<SiteLayout
  title="Thảo Nguyên - Sâm Ngọc Linh | Trang chủ"
  description={hero?.body || 'Sâm Ngọc Linh và dược liệu quý từ núi rừng Việt Nam.'}
  hero={sections[0]?.type === 'hero'}
  image={hero?.image || undefined}
  footer={!hasContact}
>
  <main>
    {sections.map((section) => {
      if (section.type === 'hero') return (
        <section class="hero" id="hero" data-page-section="hero" style={section.image ? `background-image: url('${section.image}')` : undefined}>
          <div class="hero-overlay"></div>
          <div class="hero-content hero-content-right" data-aos="fade-scale">
            <h1 class="hero-title">{section.title}</h1>
            {section.body && <p class="hero-subtitle">{section.body}</p>}
            <div class="hero-actions">
              <a class="hero-btn hero-btn--primary" href={section.cta_link || '/products/'}>{section.cta_label || 'Xem sản phẩm'}</a>
              <a class="hero-btn hero-btn--ghost" href={hotline.zalo} target="_blank" rel="noopener">Tư vấn qua Zalo</a>
            </div>
          </div>
          <a class="scroll-indicator" href="#about" aria-label="Cuộn xuống">
            <span>Cuộn xuống</span>
            <div class="scroll-arrow"></div>
          </a>
        </section>
      );

      if (section.type === 'categories') return (
        <div class="story-group" id="about" data-page-section="categories">
          <div class="story-heading product-story-beige">
            <h2 class="section-title centered">{section.title}</h2>
            {section.body && <p class="section-intro centered section-description">{section.body}</p>}
          </div>
          {categories.map((category, index) => {
            const even = index % 2 === 0;
            return (
              <section
                class:list={['product-story-section', even ? 'product-story-beige' : 'product-story-white']}
                id={index === categories.length - 1 ? 'categories' : undefined}
                data-aos={even ? 'fade-right' : 'fade-left'}
                aria-labelledby={`category-${category.slug}`}
              >
                <div class:list={['product-story-container', !even && 'product-story-reverse']}>
                  <div class="product-story-image" data-aos={even ? 'slide-left' : 'slide-right'} data-aos-delay="100">
                    <img src={category.image} alt={category.alt} class="product-story-img" loading="lazy" />
                  </div>
                  <div class="product-story-content">
                    <h3 class="product-story-title" id={`category-${category.slug}`}>{category.title}</h3>
                    <div class="product-story-logo"><span class="logo-text">Thảo Nguyên - Sâm Ngọc Linh</span></div>
                    {category.description && <p class="product-story-description">{category.description}</p>}
                    <a href={`/products/categories/${category.slug}/`} class="product-story-btn" aria-label={`Khám phá ${category.title}`}>Khám phá &gt;&gt;</a>
                  </div>
                </div>
              </section>
            );
          })}
        </div>
      );

      if (section.type === 'products') return (
        <section class="featured-products" id="products" data-page-section="products">
          <div class="container">
            <h2 class="section-title centered">{section.title}</h2>
            {section.body && <p class="section-intro centered section-description">{section.body}</p>}
            <div class="products-grid">
              {products.map((product, index) => (
                <article class="product-card" data-aos="slide-up" data-aos-delay={delay(index)}>
                  <a class="product-card-link" href={`/products/${product.slug}/`} aria-label={product.title}>
                    <div class="product-image"><img src={product.image} alt={product.alt} class="product-img" loading="lazy" /></div>
                    <div class="product-info">
                      <p class="product-meta">{categoryTitle(product.category)}</p>
                      <h3 class="product-name">{product.title}</h3>
                      <p class="product-description">{product.summary}</p>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </div>
        </section>
      );

      if (section.type === 'recipes') return (
        <section class="recipes-section" id="recipes" data-page-section="recipes">
          <div class="container">
            <h2 class="section-title centered">{section.title}</h2>
            {section.body && <p class="section-intro centered section-description">{section.body}</p>}
            <div class="recipes-grid">
              {(section.items || []).map((item, index) => (
                <div class="recipe-card" data-aos="slide-up" data-aos-delay={String((index + 1) * 100)}>
                  <h3 class="recipe-title">{item.title}</h3>
                  {item.body && <p class="recipe-description">{item.body}</p>}
                </div>
              ))}
            </div>
          </div>
        </section>
      );

      if (section.type === 'values' || section.type === 'certificates') {
        const items: Item[] = section.type === 'values'
          ? section.items || []
          : certificates.map((title) => ({ icon: '🏅', title }));
        return (
          <section class="brand-values" id={section.type} data-page-section={section.type}>
            <div class="container">
              <h2 class="section-title centered">{section.title}</h2>
              {section.body && <p class="section-intro centered section-description">{section.body}</p>}
              <div class="values-grid">
                {items.map((item, index) => (
                  <div class="value-card" data-aos={index % 2 ? 'slide-left' : 'slide-right'} data-aos-delay={String((index + 1) * 100)}>
                    {item.icon && <div class="value-icon" aria-hidden="true">{item.icon}</div>}
                    <h3 class="value-title">{item.title}</h3>
                    {item.body && <p class="value-description">{item.body}</p>}
                  </div>
                ))}
              </div>
            </div>
          </section>
        );
      }

      if (section.type === 'contact') return <SiteFooter asSection />;
    })}
  </main>
</SiteLayout>
